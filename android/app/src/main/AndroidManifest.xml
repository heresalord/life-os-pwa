<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ── Main Capacitor Activity ───────────────────────────────────── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── File Provider (Capacitor requirement) ─────────────────────── -->
        <!-- ── Homescreen Widget Receivers ─────────────────────────────────── -->

        <receiver
            android:name=".TasksWidget"
            android:exported="true"
            android:label="Tasks Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

        <receiver
            android:name=".FinanceWidget"
            android:exported="true"
            android:label="Finance Snapshot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finance_info" />
        </receiver>

        <receiver
            android:name=".InboxWidget"
            android:exported="true"
            android:label="Inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ── Homescreen Widget: Tasks Today ────────────────────────────── -->
        <receiver
            android:name=".TasksWidget"
            android:exported="true"
            android:label="Life OS — Tasks Today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>

        <!-- ── Homescreen Widget: Finance Snapshot ───────────────────────── -->
        <receiver
            android:name=".FinanceWidget"
            android:exported="true"
            android:label="Life OS — Finance Snapshot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finance_info" />
        </receiver>

        <!-- ── Homescreen Widget: Inbox ──────────────────────────────────── -->
        <receiver
            android:name=".InboxWidget"
            android:exported="true"
            android:label="Life OS — Inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
