<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_background.xml  (res/drawable-night/)
  Dark glass effect: semi-transparent dark surface with rounded corners.
  Used as the background for all Life OS widgets in dark mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- ~22% opacity black = frosted dark glass -->
    <solid android:color="#38000000" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#28FFFFFF" />
</shape>
