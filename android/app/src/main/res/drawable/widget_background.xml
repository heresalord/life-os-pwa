<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_background.xml  (res/drawable/)
  Light glass effect: semi-transparent white surface with rounded corners.
  Used as the background for all Life OS widgets in light mode.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- ~70% opacity white = frosted light glass -->
    <solid android:color="#B3FFFFFF" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#28000000" />
</shape>
